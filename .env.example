# Copia este archivo a .env y rellena con los valores reales de tu proyecto
# de Supabase (Settings > API). La anon key está pensada para exponerse en
# el cliente (va protegida por las políticas RLS), pero el archivo .env en sí
# no se versiona (ver .gitignore) para no atarlo a un proyecto concreto.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Solo para la suite E2E (e2e/testUser.ts), nunca para la app en sí: crea y
# borra cuentas de prueba ya confirmadas contra el MISMO proyecto Supabase de
# arriba, sin pasar por el email de confirmación. Sácala de Supabase >
# Settings > API > "service_role" (secreta, NO la "anon" de arriba) y cópiala
# con el botón de copiar, no seleccionando el texto (ver notas de CLAUDE.md
# sobre el mismo error con STRIPE_WEBHOOK_SECRET). Sin prefijo VITE_ a
# propósito: así nunca se empaqueta en el bundle del cliente, solo Playwright
# (proceso Node) la lee. No la compartas ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
